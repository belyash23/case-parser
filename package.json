{
    "$schema":  "https://www.schemastore.org/package.json",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "build":  "vite build",
                    "build:ssr":  "vite build \u0026\u0026 vite build --ssr",
                    "dev":  "vite",
                    "format":  "prettier --write \"resources/js/**/*.{ts,vue}\" \"resources/css/**/*.css\"",
                    "format:check":  "prettier --check \"resources/js/**/*.{ts,vue}\" \"resources/css/**/*.css\"",
                    "lint":  "eslint . --fix",
                    "lint:check":  "eslint .",
                    "types:check":  "vue-tsc --noEmit"
                },
    "devDependencies":  {
                            "@eslint/js":  "^9.19.0",
                            "@laravel/vite-plugin-wayfinder":  "^0.1.3",
                            "@stylistic/eslint-plugin":  "^5.10.0",
                            "@types/node":  "^22.13.5",
                            "@vitejs/plugin-vue":  "6.0.8",
                            "@vue/compiler-sfc":  "3.5.41",
                            "eslint":  "^9.17.0",
                            "eslint-config-prettier":  "^10.0.1",
                            "eslint-import-resolver-typescript":  "^4.4.4",
                            "eslint-plugin-import":  "^2.32.0",
                            "eslint-plugin-vue":  "^9.32.0",
                            "globals":  "^15.14.0",
                            "prettier":  "^3.4.2",
                            "prettier-plugin-tailwindcss":  "^0.6.11",
                            "typescript-eslint":  "^8.23.0",
                            "vue-tsc":  "3.3.8",
                            "concurrently":  "^9.0.1"
                        },
    "dependencies":  {
                         "@inertiajs/vite":  "3.4.0",
                         "@inertiajs/vue3":  "3.4.0",
                         "@tailwindcss/vite":  "^4.1.11",
                         "laravel-vite-plugin":  "^3.1.0",
                         "tailwindcss":  "^4.0.0",
                         "typescript":  "^5.7.2",
                         "vite":  "8.1.5",
                         "vue":  "3.5.41"
                     }
}
