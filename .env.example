APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
# DB_HOST=mariadb
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PARSER_CAMPAIGN_STALE_AFTER_SECONDS=900
PARSER_INITIAL_MAXIMUM_CASE_ATTEMPTS=3
PARSER_REGULAR_SCHEDULING_ENABLED=true
PARSER_REGULAR_SCHEDULED_SLICE_SECONDS=50
PARSER_REGULAR_CAPACITY_UTILIZATION_PERCENT=80
PARSER_REGULAR_BASE_BUDGET_PERCENT=40
PARSER_REGULAR_MAXIMUM_COURT_SHARE_PERCENT=10
PARSER_REGULAR_MAXIMUM_CASE_ATTEMPTS=3
PARSER_REGULAR_FAILURE_RETRY_MINUTES=60
PARSER_REGULAR_RECHECK_INTERVAL_DAYS=30
PARSER_REGULAR_RECHECK_STARVATION_DAYS=45

SUDRF_MIN_REQUEST_INTERVAL_MS=10000
SUDRF_CONNECT_TIMEOUT_SECONDS=10
SUDRF_DIRECTORY_TIMEOUT_SECONDS=45
SUDRF_FORBIDDEN_COOLDOWN_SECONDS=21600
SUDRF_RATE_LIMIT_COOLDOWN_SECONDS=21600
SUDRF_TIMEOUT_CIRCUIT_THRESHOLD=3
SUDRF_TIMEOUT_COOLDOWN_SECONDS=3600

SUDRF_MONITORING_ENABLED=false
SUDRF_MONITORING_REUSE_WINDOW_MINUTES=10
SUDRF_MONITORING_TIMEOUT_SECONDS=45
SUDRF_MONITORING_CONNECT_TIMEOUT_SECONDS=10
SUDRF_MONITORING_FAILURE_THRESHOLD=2
SUDRF_MONITORING_RECOVERY_THRESHOLD=2
# SUDRF_MONITORING_PROBE_NODE=spb-3-vm-u2on
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_DIRECTORY=backups/database
DATABASE_BACKUP_RETENTION_DAYS=7
DATABASE_BACKUP_TIMEOUT_SECONDS=3600

PARSER_OPERATIONAL_PRUNING_ENABLED=true
PARSER_REQUEST_LOG_RETENTION_DAYS=90
PARSER_ERROR_RETENTION_DAYS=180
PARSER_AVAILABILITY_CHECK_RETENTION_DAYS=365
PARSER_WORK_ITEM_RETENTION_DAYS=180
PARSER_RUN_RETENTION_DAYS=365
PARSER_RAW_PAGE_FILE_RETENTION_DAYS=90
PARSER_RAW_PAGE_RECORD_RETENTION_DAYS=180
